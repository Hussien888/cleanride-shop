# --- Grundeinstellungen ---
PORT=3000
NODE_ENV=development
# Öffentliche Adresse. Im Livebetrieb MUSS sie mit https:// beginnen.
# Auf Render nicht nötig (wird automatisch übernommen); bei eigener Domain hier eintragen.
APP_URL=http://localhost:3000
# Hinter einem Proxy/Hoster (Render, Railway, Caddy ...) auf 1 setzen:
# TRUST_PROXY=1
# Speicherort der Datenbank (im Livebetrieb auf den dauerhaften Datenträger zeigen, z. B. /data)
# DATA_DIR=/data

# --- Sicherheit (im Livebetrieb Pflicht) ---
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Dein Admin-Konto, wird beim ersten Start angelegt (Passwort mind. 12 Zeichen)
ADMIN_EMAIL=admin@cleanride.local
ADMIN_PASSWORD=

# --- Pflichtangaben für Impressum und Datenschutz (im Livebetrieb Pflicht) ---
LEGAL_NAME=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
# Optional, aber empfohlen: zweiter Kontaktweg
# LEGAL_PHONE=
# Optional: USt-IdNr. oder "Kleinunternehmer nach § 19 UStG"
# LEGAL_VAT=
# Z. B. "Render Services, Inc. (Serverstandort Frankfurt am Main)"
HOSTING_PROVIDER=
# Pflicht, sobald SMTP genutzt wird, z. B. "Brevo (Sendinblue SAS, Frankreich)"
MAIL_PROVIDER=
# Optional: Aufbewahrung der Server-Logs in Tagen, Aufsichtsbehörde, USt-Hinweis in den AGB
# LOG_DAYS=7
# DATA_AUTHORITY=Die Landesbeauftragte für den Datenschutz Niedersachsen
# PRICES_VAT=inklusive der gesetzlichen Umsatzsteuer, sofern diese anfällt
# Erst auf true setzen, NACHDEM die Rechtstexte rechtlich geprüft wurden (blendet den Entwurf-Hinweis aus)
LEGAL_REVIEWED=false


# --- Zahlung über Stripe Checkout ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-Mail (Benachrichtigungen und "Passwort vergessen") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CLEANRIDE <noreply@deine-domain.de>

# --- Demo-Daten (nur lokal, im Livebetrieb false) ---
SEED_DEMO=false

# CLEANRIDE Shop
SHOP_READY=false
SHOP_PRICE_CENTS=3490
SHOP_SHIPPING_CENTS=490
# SHOP_READY erst auf true setzen, wenn Lieferant, echte Produktdaten, Rechtstexte, Stripe und Testbestellung geprüft sind.
